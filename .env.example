# ===== Routing engine =====
# classifier (default, offline, free) | llm (needs API key) | hybrid (LLM first, classifier fallback)
ROUTER_DEFAULT=classifier
# Minimum confidence before a complaint is auto-routed
CONFIDENCE_ACCEPT=0.55
MIN_ROUTE_CONFIDENCE=0.35
# Train a small scikit-learn TF-IDF + Naive Bayes model at startup (no data needed)
USE_ML=true

# ===== Optional LLM router (OpenAI-compatible) =====
# Leave LLM_API_KEY empty to run fully offline with the keyword/ML classifier.
# Set it to also cross-check with an LLM (works with any OpenAI-compatible endpoint).
#LLM_API_KEY=
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_MODEL=gpt-4o-mini

# ===== Alerts (SMS/email, simulated by default) =====
ALERT_ENABLED=true
# Fill SMTP details to send real email notifications instead of simulated ones
#EMAIL_SMTP_HOST=smtp.gmail.com
#EMAIL_SMTP_PORT=587
#EMAIL_USERNAME=you@gmail.com
#EMAIL_PASSWORD=your-app-password
#EMAIL_FROM=no-reply@grievancepath.in

# ===== Demo auth (change these for production) =====
ADMIN_PASSWORD=admin123
DEPT_PASSWORD=dept123
